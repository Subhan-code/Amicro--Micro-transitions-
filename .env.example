# Polar Payments Configuration
# Get your access token from Polar Dashboard: https://polar.sh/settings
POLAR_ACCESS_TOKEN=polar_at_your_access_token_here
POLAR_WEBHOOK_SECRET=polar_whsec_your_webhook_secret_here

# Product IDs (defaults configured in src/data/tiers.ts)
POLAR_PRODUCT_DIAMOND=2fcd67d7-3f48-4d3e-b6e3-10b6cae99a6a
POLAR_PRODUCT_GOLD=ff47249c-8f45-4242-bd8d-466c1fbfb609
POLAR_PRODUCT_SILVER=dd643ac1-9559-4430-ad6b-cd8ebef2f5a9

# Admin Authentication & Review Dashboard (/admin/sponsors)
ADMIN_SECRET_KEY=your_secure_admin_passphrase_here

# Sponsor Notifications (Discord / Slack / Generic Webhook)
# Dispatches formatted sponsor info upon submission
ADMIN_NOTIFICATION_WEBHOOK=https://discord.com/api/webhooks/...

# Optional Supabase Database (if using Supabase instead of local json db)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site Domain URL (used for success redirect URL generation)
# VITE_SITE_URL=https://amicro.dev
